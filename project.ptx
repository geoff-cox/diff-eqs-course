<?xml version="1.0" encoding="utf-8"?>
<!-- This file, the project manifest, provides the overall configuration for your PreTeXt project. To edit the content of your document, open `source/main.ptx`. See https://pretextbook.org/doc/guide/html/processing-CLI.html#cli-project-manifest. -->
<project 
  ptx-version="2"
  output-dir="output"
  >
  <targets>
    <target name="stu" 
            format="html" 
            source="homepage.ptx"
            publication="stu-pub.ptx"
            output-dir="stu"
            deploy-dir="stu"
      />
    <!-- <target name="stu-pdf" 
            format="pdf" 
            source="homepage.ptx"
            publication="stu-pub-pdf.ptx"
            output-dir="stu-pdf"
            deploy-dir="stu-pdf"
      /> -->
    <!-- Instructor answer key.  Deliberately carries NO deploy-dir:
         a target is published iff it has one, so this builds locally
         (`pretext build key` gives output/key) while CI, which builds
         only the deploy targets, never builds or publishes it.
         Do NOT add deploy-dir here: that would put the full answer
         key on the public Pages site at .../key/, which
         site/index.html does not link but does not protect either. -->
    <target name="key"
            format="html"
            source="homepage.ptx"
            publication="key-pub.ptx"
            output-dir="key"
      />
  </targets>
</project>