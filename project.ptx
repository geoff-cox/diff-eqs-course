<?xml version="1.0" encoding="utf-8"?>
<!-- This file, the project manifest, provides the overall configuration for your PreTeXt project. To edit the content of your document, open `source/main.ptx`. See https://pretextbook.org/doc/guide/html/processing-CLI.html#cli-project-manifest. -->
<project 
  ptx-version="2"
  output-dir="output"
  >
  <targets>
    <!--
      stu vs. key Guided Lecture Notes. The two targets share the
      same source (notes.ptx) and differ only in their publication file:
        * worksheet <exercise> solutions: hidden for students, shown for
          instructors (exercise-worksheet solution="no|yes");
        * paired component="stu" / component="key" elements: selected by the
          publication's <source><version include="notes stu|key"/> (see
          CLAUDE.md section 4 for the pairing conventions).
    -->
    <target 
      name="homepage" 
      format="html" 
      source="homepage.ptx"
      publication="homepage-pub.ptx"
      output-dir="stu"
      deploy-dir="stu">
    </target>
    <target
      name="key"
      format="html"
      source="homepage.ptx"
      publication="key-pub.ptx"
      output-dir="key"
      deploy-dir="key">
    </target>
  </targets>
</project>